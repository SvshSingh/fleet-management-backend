# Copy to .env to override. Every value below has a working default baked in, so
# `docker compose up` needs none of this.

# --- host ports (only if 8000/1883 are already taken on your machine) --------
API_PORT=8000
BROKER_PORT=1883

# --- simulation -------------------------------------------------------------
SPEED_FACTOR=5              # 1 = real time; 5 replays the 15-min window in 3 min
CHAOS_DISCONNECT_PROB=0     # e.g. 0.01 to randomly drop robot sockets and watch recovery
PUBLISHER_BUFFER_MAX=200    # samples held while a robot is disconnected

# --- liveness ---------------------------------------------------------------
STALE_AFTER_SECONDS=12      # ~2 missed 5s ticks
LOST_AFTER_SECONDS=30       # ~6 missed ticks
WATCHDOG_INTERVAL_SECONDS=2

# --- policy -----------------------------------------------------------------
LOW_BATTERY_PCT=20

# --- websocket hub ----------------------------------------------------------
HUB_REPLAY_BUFFER=500
HUB_SUBSCRIBER_QUEUE=256
HUB_HEARTBEAT_SECONDS=10

# --- history (stretch goal) -------------------------------------------------
HISTORY_ENABLED=true
